# Everything in rpi/ is built and run on the Pi (Linux): keep LF line endings in the working copy too,
# so scripts copied from a Windows checkout do not fail with "\r: command not found".
*.sh       text eol=lf
*.c        text eol=lf
*.h        text eol=lf
*.py       text eol=lf
*.md       text eol=lf
*.csv      text eol=lf
*.log      text eol=lf
Makefile   text eol=lf
